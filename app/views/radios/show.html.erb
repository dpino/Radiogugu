<div style="margin-bottom: 10px">
  <h2 style="display: inline"><%= @radio.name %></h2>
  <% if (current_user != nil) %>
    <% if (@is_favorite) %>
      <span id="remove-from-favorites" name='{"id" : <%= @radio.id %> }'>[Remove from favorites]</span>
    <% else %>
      <span id="add-to-favorites" name='{"id" : <%= @radio.id %> }'>[Add to favorites]</span>
    <% end %>
  <% end %>
</div>

<!-- Show breadcrum Continent >> Country >> Location -->
<b><%= location_breadcrumb(@radio) %></b>
<br/><br/>

<div id="radio-station-data">
    <table>
      <tr>
        <td><b>Website</b>:</td>
        <td><span id="website-url"><a href="<%= @radio.website %>"><%= @radio.website %></a></span></td>
        <% if (current_user != nil) %>
          <td><span style="color: #53a3f6" id="radio-station-data-edit" name="<%= @radio.id %>">[Edit]</span></td>
        <% else %>
          <td>&nbsp;</td>
        <% end %>
      </tr>
      <tr>
        <td><b>Tags</b>:</td>
        <td colspan="2"><span id="tag-list"><%= @radio.gender %></span></td>
      </tr>
      <tr>
        <td><b>URL</b>:</td>
        <td colspan="2"><span id="radio-url"><%= @radio.url %></span></td>
        <!-- <span class="formw"><input id="button_url_ok" type="button" value="OK"/></span> -->
      </tr>
    </table>
</div>

<br/>

<div id="radioplayer">
  <audio id="radio-audio" controls preload="none" data-src="<%= @radio.url %>">
    Your browser does not support playing audio streams directly.
    You can still listen via the station's <%= link_to "stream URL", @radio.url %>.
  </audio>
  <div id="now-playing" hidden></div>
</div>

<script>
  (function() {
    var audio = document.getElementById('radio-audio');
    var nowPlaying = document.getElementById('now-playing');
    var src = audio.getAttribute('data-src');
    var isHls = /\.m3u8(\?|$)/i.test(src);

    // Chrome/Firefox can't play HLS (.m3u8) streams natively - use hls.js for
    // those. Safari supports HLS natively, and everything else is a regular
    // MP3/AAC stream the <audio> element already handles on its own.
    if (isHls && !audio.canPlayType('application/vnd.apple.mpegurl') && window.Hls && Hls.isSupported()) {
      var hls = new Hls();
      hls.loadSource(src);
      hls.attachMedia(audio);
    } else {
      audio.src = src;
    }

    // "Now playing" title, fetched server-side from the stream's own ICY
    // metadata where available (see now_playing.js) - not every station
    // supports this, so the line simply never appears when it isn't. Not
    // attempted for HLS, which uses a different metadata mechanism entirely.
    if (!isHls && window.RadioGuguNowPlaying) {
      var stopPolling = null;
      var nowPlayingUrl = '<%= now_playing_radio_path(@radio) %>';
      audio.addEventListener('play', function() {
        if (!stopPolling) stopPolling = window.RadioGuguNowPlaying.start(nowPlayingUrl, nowPlaying);
      });
      audio.addEventListener('pause', function() {
        if (stopPolling) { stopPolling(); stopPolling = null; }
        nowPlaying.hidden = true;
      });
    }
  })();
</script>

<%= render :partial => "ratings/rate", :locals => { :asset => @radio } %>

<hr/>

<%= render :partial => "comments/comments" %>
