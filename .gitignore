# Ignore bundler config.
/.bundle
/vendor/bundle

# Ignore the default SQLite database.
/storage/*.sqlite3
/storage/*.sqlite3-*
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore various generated / runtime files.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and any other unencrypted secrets.
/config/master.key

# Local transcription prototype's Python virtualenv (see transcriber/README.md)
/transcriber/venv
